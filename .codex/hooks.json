{
  "description": "Register the repository hooks from .agents/hooks for Codex.",
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.agents/hooks/scripts/audit-log.sh\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "^Bash$",
        "hooks": [
          { "type": "command", "command": "bash \"$(git rev-parse --show-toplevel)/.agents/hooks/scripts/commit-msg-guard.sh\"", "timeout": 30 },
          { "type": "command", "command": "bash \"$(git rev-parse --show-toplevel)/.agents/hooks/scripts/bugfix-test-reminder.sh\"", "timeout": 30 },
          { "type": "command", "command": "bash \"$(git rev-parse --show-toplevel)/.agents/hooks/scripts/secret-scan.sh\"", "timeout": 30 },
          { "type": "command", "command": "bash \"$(git rev-parse --show-toplevel)/.agents/hooks/scripts/protected-branch-guard.sh\"", "timeout": 30 },
          { "type": "command", "command": "bash \"$(git rev-parse --show-toplevel)/.agents/hooks/scripts/format-before-push.sh\"", "timeout": 120 }
        ]
      },
      {
        "matcher": "^Agent$",
        "hooks": [
          { "type": "command", "command": "bash \"$(git rev-parse --show-toplevel)/.agents/hooks/scripts/condense-planner-input.sh\"", "timeout": 30 },
          { "type": "command", "command": "bash \"$(git rev-parse --show-toplevel)/.agents/hooks/scripts/agent-role-reminder.sh\"", "timeout": 30 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(apply_patch|Edit|Write)$",
        "hooks": [
          { "type": "command", "command": "repo_root=\"$(git rev-parse --show-toplevel 2>/dev/null)\" && script=\"$repo_root/.agents/hooks/scripts/ensure-final-newline.mjs\" && [ -f \"$script\" ] && node \"$script\"", "timeout": 30 },
          { "type": "command", "command": "bash \"$(git rev-parse --show-toplevel)/.agents/hooks/scripts/format-on-edit.sh\"", "async": true, "timeout": 120 },
          { "type": "command", "command": "bash \"$(git rev-parse --show-toplevel)/.agents/hooks/scripts/lint-on-edit.sh\"", "async": true, "timeout": 120, "additionalContextLimit": 2500 },
          { "type": "command", "command": "bash \"$(git rev-parse --show-toplevel)/.agents/hooks/scripts/test-reminder.sh\"", "async": true, "timeout": 120, "additionalContextLimit": 2500 },
          { "type": "command", "command": "bash \"$(git rev-parse --show-toplevel)/.agents/hooks/scripts/ci-workflow-lint.sh\"", "async": true, "timeout": 120, "additionalContextLimit": 2500 }
        ]
      },
      {
        "matcher": "^Bash$",
        "hooks": [
          { "type": "command", "command": "bash \"$(git rev-parse --show-toplevel)/.agents/hooks/scripts/dependency-audit-reminder.sh\"", "async": true, "timeout": 120, "additionalContextLimit": 2000 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "bash \"$(git rev-parse --show-toplevel)/.agents/hooks/scripts/remind-cleanup.sh\"", "timeout": 30, "additionalContextLimit": 1500 },
          { "type": "command", "command": "bash \"$(git rev-parse --show-toplevel)/.agents/hooks/scripts/report-reminder.sh\"", "timeout": 30, "additionalContextLimit": 1500 },
          { "type": "command", "command": "bash \"$(git rev-parse --show-toplevel)/.agents/hooks/scripts/notify-done.sh\"", "async": true, "timeout": 10 }
        ]
      }
    ]
  }
}
