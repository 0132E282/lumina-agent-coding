{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/scripts/markitdown.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/scripts/audit-log.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/scripts/commit-msg-guard.sh"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/scripts/secret-scan.sh"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/scripts/protected-branch-guard.sh"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/scripts/format-before-push.sh"
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/scripts/condense-planner-input.sh"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/scripts/agent-role-reminder.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/scripts/ensure-final-newline.mjs",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/scripts/format-on-edit.sh"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/scripts/lint-on-edit.sh"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/scripts/test-reminder.sh"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/scripts/missing-test-reminder.sh"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/scripts/ci-workflow-lint.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/scripts/dependency-audit-reminder.sh"
          },
          {
            "type": "command",
            "command": "node .claude/hooks/scripts/test-token-usage.mjs",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/scripts/remind-cleanup.sh"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/scripts/report-reminder.sh"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/scripts/notify-done.sh"
          }
        ]
      }
    ]
  }
}
